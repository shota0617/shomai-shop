# ===== 必須（本番） =====
BASE_URL=https://shomai.example.com
ADMIN_PASSWORD=長くて推測されないパスワード

# Stripe（未設定ならデモモード＝擬似決済）
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PAYMENT_METHODS=card,konbini

# メール（Resend。未設定なら data/outbox/ に保存するだけ）
RESEND_API_KEY=re_...
MAIL_FROM=翔米 <shop@shomai.example.com>
OWNER_EMAIL=店主のメールアドレス

# ===== 配送 =====
# yamato または japanpost（管理画面で注文ごとに変更可）
DEFAULT_CARRIER=yamato
YAMATO_EMAIL=担当営業所のメールアドレス
YAMATO_CUSTOMER_CODE=請求先顧客コード
YAMATO_FREIGHT_CODE=01
JAPANPOST_EMAIL=担当郵便局のメールアドレス
JAPANPOST_CUSTOMER_CODE=

# この時刻までの入金は当日発送。同時刻に業者へ送り状データを送信
SHIP_CUTOFF=12:00
# 発送日のこの時刻に「発送しました」メール
SHIPPED_NOTICE_AT=18:00
# 定休日（0=日 1=月 … 6=土）。複数はカンマ区切り
CLOSED_WEEKDAYS=0
# 臨時休業日
HOLIDAYS=2026-12-31,2027-01-01
MAX_BOX_KG=20
SHIPPING_FEE_PER_BOX=990
FREE_SHIPPING_FROM=10000

# ===== 送り状の差出人（ご依頼主） =====
SENDER_NAME=近藤米穀店 らいすぴあ
SENDER_NAME_KANA=ｺﾝﾄﾞｳﾍﾞｲｺｸﾃﾝ
SENDER_ZIP=
SENDER_ADDRESS=
SENDER_TEL=

# ===== 特定商取引法に基づく表記（公開前に必ず記入） =====
LEGAL_SELLER=近藤米穀店
LEGAL_MANAGER=
LEGAL_ADDRESS=
LEGAL_TEL=
LEGAL_EMAIL=
