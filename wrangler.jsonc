// 翔米ショップの Cloudflare Workers 設定。
// らいすぴあポイントシステムとは Worker・データベース（D1）・ドメインをすべて別にしている（共有するのは Cloudflare アカウントだけ）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shomai-shop",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // 商品ページなど public/ のファイルは Cloudflare が直接配信する
  "assets": { "directory": "./public" },

  // 翔米専用のデータベース。ダッシュボードの D1 で「shomai-shop」を作り、表示された Database ID をここに書く
  "d1_databases": [
    { "binding": "DB", "database_name": "shomai-shop", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],

  // 5分ごとに自動処理（締め時刻の業者送信・夕方の発送通知）を確認する
  "triggers": { "crons": ["*/5 * * * *"] },

  // 設定値（BASE_URL・店の住所・業者のメールなど）と秘密の値（Stripe のキーなど）は、
  // ダッシュボードの「設定 → 変数とシークレット」で登録する。デプロイしても消えないようにする。
  "keep_vars": true,

  "observability": { "enabled": true }
}
